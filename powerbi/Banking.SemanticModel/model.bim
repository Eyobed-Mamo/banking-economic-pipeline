          },
          {
            "name": "error_type",
            "dataType": "string",
            "sourceColumn": "error_type",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Pipeline",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(Server, Database, [CreateNavigationProperties=false]),",
                "    Data = Source{[Schema=\"public\", Item=\"vw_pipeline_health\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": []
      },
      {
        "name": "Calendar",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "Year",
            "dataType": "int64",
            "sourceColumn": "Year",
            "summarizeBy": "none"
          },
          {
            "name": "Quarter",
            "dataType": "string",
            "sourceColumn": "Quarter",
            "summarizeBy": "none"
          },
          {
            "name": "Month",
            "dataType": "dateTime",
            "sourceColumn": "Month",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Calendar",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Start = #date(2000,1,1),",
                "    Finish = #date(2035,12,31),",
                "    Days = Table.FromList(List.Dates(Start,Duration.Days(Finish-Start)+1,#duration(1,0,0,0)),Splitter.SplitByNothing(),{\"Date\"}),",
                "    Typed = Table.TransformColumnTypes(Days,{{\"Date\",type date}}),",
                "    Years = Table.AddColumn(Typed,\"Year\",each Date.Year([Date]),Int64.Type),",
                "    Quarters = Table.AddColumn(Years,\"Quarter\",each \"Q\" & Text.From(Date.QuarterOfYear([Date])),type text),",
                "    Months = Table.AddColumn(Quarters,\"Month\",each Date.StartOfMonth([Date]),type date)",
                "in",
                "    Months"
              ]
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Date hierarchy",
            "levels": [
              {
                "name": "Year",
                "ordinal": 0,
                "column": "Year"
              },
              {
                "name": "Quarter",
                "ordinal": 1,
                "column": "Quarter"
              },
              {
                "name": "Month",
                "ordinal": 2,
                "column": "Month"
              }
            ]
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "Calendar_Monthly",
        "fromTable": "Monthly",
        "fromColumn": "month",
        "toTable": "Calendar",
        "toColumn": "Date",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Calendar_Yield Curve",
        "fromTable": "Yield Curve",
        "fromColumn": "observation_date",
        "toTable": "Calendar",
        "toColumn": "Date",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Calendar_Inflation",
        "fromTable": "Inflation",
        "fromColumn": "month",
        "toTable": "Calendar",
        "toColumn": "Date",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Calendar_Credit",
        "fromTable": "Credit",
        "fromColumn": "quarter_start",
        "toTable": "Calendar",
        "toColumn": "Date",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Calendar_Mortgage",
        "fromTable": "Mortgage",
        "fromColumn": "observation_date",
        "toTable": "Calendar",
        "toColumn": "Date",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Series_Monthly",
        "fromTable": "Monthly",
        "fromColumn": "series_id",
        "toTable": "Series",
        "toColumn": "series_id",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Series_Snapshot",
        "fromTable": "Snapshot",
        "fromColumn": "series_id",
        "toTable": "Series",
        "toColumn": "series_id",
        "crossFilteringBehavior": "oneDirection"
      }
    ],
    "expressions": [
      {
        "name": "Server",
        "kind": "m",
        "expression": "\"localhost:5433\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "Database",
        "kind": "m",
        "expression": "\"fred_pipeline\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "annotations": [
      {
        "name": "PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}
