{
  "name": "Banking Economic Conditions",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "Series",
        "columns": [
          {
            "name": "series_id",
            "dataType": "string",
            "sourceColumn": "series_id",
            "summarizeBy": "none"
          },
          {
            "name": "title",
            "dataType": "string",
            "sourceColumn": "title",
            "summarizeBy": "none"
          },
          {
            "name": "units",
            "dataType": "string",
            "sourceColumn": "units",
            "summarizeBy": "none"
          },
          {
            "name": "frequency",
            "dataType": "string",
            "sourceColumn": "frequency",
            "summarizeBy": "none"
          },
          {
            "name": "category",
            "dataType": "string",
            "sourceColumn": "category",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Series",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(Server, Database, [CreateNavigationProperties=false]),",
                "    Data = Source{[Schema=\"public\", Item=\"dim_series\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": []
      },
      {
        "name": "Monthly",
        "columns": [
          {
            "name": "series_id",
            "dataType": "string",
            "sourceColumn": "series_id",
            "summarizeBy": "none"
          },
          {
            "name": "month",
            "dataType": "dateTime",
            "sourceColumn": "month",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "value",
            "dataType": "double",
            "sourceColumn": "value",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "observation_count",
            "dataType": "int64",
            "sourceColumn": "observation_count",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Monthly",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(Server, Database, [CreateNavigationProperties=false]),",
                "    Data = Source{[Schema=\"public\", Item=\"vw_monthly_indicators\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Indicator value",
            "expression": "AVERAGE(Monthly[value])",
            "formatString": "0.00"
          },
          {
            "name": "Fed funds",
            "expression": "CALCULATE([Indicator value], REMOVEFILTERS(Series), Monthly[series_id] = \"FEDFUNDS\")",
            "formatString": "0.00"
          },
          {
            "name": "Unemployment",
            "expression": "CALCULATE([Indicator value], REMOVEFILTERS(Series), Monthly[series_id] = \"UNRATE\")",
            "formatString": "0.00"
          }
        ]
      },
      {
        "name": "Yield Curve",
        "columns": [
          {
            "name": "observation_date",
            "dataType": "dateTime",
            "sourceColumn": "observation_date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "yield_10y",
            "dataType": "double",
            "sourceColumn": "yield_10y",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "yield_2y",
            "dataType": "double",
            "sourceColumn": "yield_2y",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "spread_bps",
            "dataType": "double",
            "sourceColumn": "spread_bps",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "is_inverted",
            "dataType": "boolean",
            "sourceColumn": "is_inverted",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Yield Curve",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(Server, Database, [CreateNavigationProperties=false]),",
                "    Data = Source{[Schema=\"public\", Item=\"vw_yield_curve\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "10Y yield",
            "expression": "AVERAGE('Yield Curve'[yield_10y])",
            "formatString": "0.00"
          },
          {
            "name": "2Y yield",
            "expression": "AVERAGE('Yield Curve'[yield_2y])",
            "formatString": "0.00"
          },
          {
            "name": "Spread (bps)",
            "expression": "AVERAGE('Yield Curve'[spread_bps])",
            "formatString": "0.0"
          },
          {
            "name": "Inverted days",
            "expression": "COUNTROWS(FILTER('Yield Curve', 'Yield Curve'[is_inverted] = TRUE()))",
            "formatString": "0"
          }
        ]
      },
      {
        "name": "Inflation",
        "columns": [
          {
            "name": "month",
            "dataType": "dateTime",
            "sourceColumn": "month",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "cpi_index",
            "dataType": "double",
            "sourceColumn": "cpi_index",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "inflation_yoy_pct",
            "dataType": "double",
            "sourceColumn": "inflation_yoy_pct",
            "summarizeBy": "none",
            "formatString": "0.00"
          }
        ],
        "partitions": [
          {
            "name": "Inflation",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(Server, Database, [CreateNavigationProperties=false]),",
                "    Data = Source{[Schema=\"public\", Item=\"vw_cpi_yoy\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "CPI inflation YoY",
            "expression": "AVERAGE(Inflation[inflation_yoy_pct])",
            "formatString": "0.00"
          }
        ]
      },
      {
        "name": "Snapshot",
        "columns": [
          {
            "name": "series_id",
            "dataType": "string",
            "sourceColumn": "series_id",
            "summarizeBy": "none"
          },
          {
            "name": "title",
            "dataType": "string",
            "sourceColumn": "title",
            "summarizeBy": "none"
          },
          {
            "name": "frequency",
            "dataType": "string",
            "sourceColumn": "frequency",
            "summarizeBy": "none"
          },
          {
            "name": "units",
            "dataType": "string",
            "sourceColumn": "units",
            "summarizeBy": "none"
          },
          {
            "name": "observation_date",
            "dataType": "dateTime",
            "sourceColumn": "observation_date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "value",
            "dataType": "double",
            "sourceColumn": "value",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "age_days",
            "dataType": "int64",
            "sourceColumn": "age_days",
            "summarizeBy": "none"
          },
          {
            "name": "is_stale",
            "dataType": "boolean",
            "sourceColumn": "is_stale",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Snapshot",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(Server, Database, [CreateNavigationProperties=false]),",
                "    Data = Source{[Schema=\"public\", Item=\"vw_latest_snapshot\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Latest fed funds",
            "expression": "CALCULATE(MAX(Snapshot[value]), REMOVEFILTERS(Series), Snapshot[series_id] = \"FEDFUNDS\")",
            "formatString": "0.00\"%\""
          },
          {
            "name": "Latest unemployment",
            "expression": "CALCULATE(MAX(Snapshot[value]), REMOVEFILTERS(Series), Snapshot[series_id] = \"UNRATE\")",
            "formatString": "0.00\"%\""
          },
          {
            "name": "Latest mortgage",
            "expression": "CALCULATE(MAX(Snapshot[value]), REMOVEFILTERS(Series), Snapshot[series_id] = \"MORTGAGE30US\")",
            "formatString": "0.00\"%\""
          },
          {
            "name": "Latest delinquency",
            "expression": "CALCULATE(MAX(Snapshot[value]), REMOVEFILTERS(Series), Snapshot[series_id] = \"DRCCLACBS\")",
            "formatString": "0.00\"%\""
          },
          {
            "name": "Stale series",
            "expression": "COUNTROWS(FILTER(Snapshot, Snapshot[is_stale] = TRUE()))",
            "formatString": "0"
          }
        ]
      },
      {
        "name": "Credit",
        "columns": [
          {
