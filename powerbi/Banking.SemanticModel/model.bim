                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "delinquency_pct",
            "dataType": "double",
            "sourceColumn": "delinquency_pct",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "fed_funds_pct",
            "dataType": "double",
            "sourceColumn": "fed_funds_pct",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "unemployment_pct",
            "dataType": "double",
            "sourceColumn": "unemployment_pct",
            "summarizeBy": "none",
            "formatString": "0.00"
          }
        ],
        "partitions": [
          {
            "name": "Credit",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(Server, Database, [CreateNavigationProperties=false]),",
                "    Data = Source{[Schema=\"public\", Item=\"vw_credit_quarterly\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Delinquency",
            "expression": "AVERAGE(Credit[delinquency_pct])",
            "formatString": "0.00"
          },
          {
            "name": "Quarterly policy rate",
            "expression": "AVERAGE(Credit[fed_funds_pct])",
            "formatString": "0.00"
          }
        ]
      },
      {
        "name": "Mortgage",
        "columns": [
          {
            "name": "observation_date",
            "dataType": "dateTime",
            "sourceColumn": "observation_date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "mortgage_pct",
            "dataType": "double",
            "sourceColumn": "mortgage_pct",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "treasury_10y_pct",
            "dataType": "double",
            "sourceColumn": "treasury_10y_pct",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "spread_pp",
            "dataType": "double",
            "sourceColumn": "spread_pp",
            "summarizeBy": "none",
            "formatString": "0.00"
          }
        ],
        "partitions": [
          {
            "name": "Mortgage",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(Server, Database, [CreateNavigationProperties=false]),",
                "    Data = Source{[Schema=\"public\", Item=\"vw_mortgage_spread\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Mortgage rate",
            "expression": "AVERAGE(Mortgage[mortgage_pct])",
            "formatString": "0.00"
          },
          {
            "name": "Mortgage spread (pp)",
            "expression": "AVERAGE(Mortgage[spread_pp])",
            "formatString": "0.00"
          }
        ]
      },
      {
        "name": "Pipeline",
        "columns": [
          {
            "name": "run_id",
            "dataType": "string",
            "sourceColumn": "run_id",
            "summarizeBy": "none"
          },
          {
            "name": "started_at",
            "dataType": "dateTime",
            "sourceColumn": "started_at",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "run_status",
            "dataType": "string",
            "sourceColumn": "run_status",
